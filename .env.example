# ──────────────────────────────────────────────
# Project AgenteD — Variables de Entorno
# ──────────────────────────────────────────────
# Copiar este archivo a .env y ajustar valores:
#   cp .env.example .env
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=agented
POSTGRES_PASSWORD=agented_pass
POSTGRES_DB=agented
DATABASE_URL=postgresql+asyncpg://agented:agented_pass@db:5432/agented

# FastAPI / Backend
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
APP_NAME=AgenteD
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RENDER_EXTERNAL_URL=http://localhost:8000

# PixelRAG
PIXELRAG_CHROME_PATH=/usr/bin/chromium
PIXELRAG_CACHE_DIR=/tmp/pixelrag-cache

# TestSprite
TESTSPRITE_API_KEY=
TESTSPRITE_PROJECT_ID=
